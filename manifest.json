{
  "manifest_version": 3,
  "name": "SEO Quick Auditor",
  "version": "1.0",
  "description": "Instant on-page SEO audit and PageSpeed performance metrics.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_width": 400
  },
  "icons": {
    "128": "icon.png"
  }
}
